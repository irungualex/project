APP_NAME=CivicDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Leave DATABASE_URL empty to use the local SQLite database.
# Set it to Neon's pooled connection string to use Neon automatically.
DB_DATABASE=database/database.sqlite

DATABASE_URL=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# Set a strong, private password before running the AdminUserSeeder.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=
