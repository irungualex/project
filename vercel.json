{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{app/**,bootstrap/**,config/**,database/**,public/**,resources/**,routes/**,storage/**,vendor/**}"
    },
    "api/assets.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "public/css/**"
    }
  },
  "routes": [
    {
      "src": "/css/app[.]css",
      "dest": "/api/assets.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
